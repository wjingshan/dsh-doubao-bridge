# Keep the shell script executable and LF-only. A CRLF shell script fails on
# macOS/Linux with "bad interpreter: /bin/sh^M".
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf

# PowerShell is fine either way, but LF keeps the file diff-friendly.
*.ps1 text eol=crlf
